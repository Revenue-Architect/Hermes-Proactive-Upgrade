{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthorizedAction",
  "type": "object",
  "required": [
    "action_id",
    "candidate_id",
    "correlation_id",
    "action_class",
    "action",
    "parameters"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "action_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
