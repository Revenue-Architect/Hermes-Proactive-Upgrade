{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProactiveEvent",
  "type": "object",
  "required": [
    "domain",
    "entity_key",
    "event_type",
    "summary",
    "source",
    "origin"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "entity_key": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "origin": {
      "type": "string",
      "enum": [
        "external",
        "user",
        "system",
        "hermes",
        "n8n"
      ]
    }
  },
  "additionalProperties": false
}
